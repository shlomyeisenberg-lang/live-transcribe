diff --git a/src/ui/ribbon/i18n.ts b/src/ui/ribbon/i18n.ts
index f3295d1..4a15015 100644
--- a/src/ui/ribbon/i18n.ts
+++ b/src/ui/ribbon/i18n.ts
@@ -51,12 +51,34 @@ const locale = ref<MenuLocale>('he');
  * רק `'en…'` מתרגם לאנגלית; כל יתר הערכים (כולל `'he-IL'`, `undefined`,
  * וכשל אתחול) משאירים עברית — שפת המקור של התוסף.
  */
+type LangHooks = {
+  __otzariaHostLang?: string | null;
+  __otzariaLangOverride?: string;
+  __otzariaApplyUiLanguage?: () => void;
+  __otzariaMenuLocale?: { setRaw(v: string): void };
+};
+
 export function setMenuLocale(language: string | null | undefined): void {
-  const code = (language ?? '').toLowerCase().split(/[-_]/)[0];
+  // English interface mode (public/assets/english-mode.js): remember what the
+  // host reported, and let the user's own choice in the title bar win over it.
+  const w = (typeof window !== 'undefined' ? window : {}) as LangHooks;
+  w.__otzariaHostLang = language ?? null;
+  const chosen = w.__otzariaLangOverride || language;
+  const code = (chosen ?? '').toLowerCase().split(/[-_]/)[0];
   locale.value = code === 'en' ? 'en' : 'he';
   if (typeof document !== 'undefined') {
     document.documentElement.setAttribute(MENU_LOCALE_ATTRIBUTE, locale.value);
   }
+  if (typeof w.__otzariaApplyUiLanguage === 'function') w.__otzariaApplyUiLanguage();
+}
+
+if (typeof window !== 'undefined') {
+  (window as LangHooks).__otzariaMenuLocale = {
+    setRaw(v: string) {
+      locale.value = v === 'en' ? 'en' : 'he';
+      document.documentElement.setAttribute(MENU_LOCALE_ATTRIBUTE, locale.value);
+    },
+  };
 }
 
